# Copy to backend/.env for local development. Never commit .env.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Matches compose.dev.yml
DATABASE_URL=postgres://relationtree:relationtree@localhost:5432/relationtree
FRONTEND_ORIGINS=http://localhost:5173
# Cloudflare R2 (photos). Optional locally: without them everything but photo uploads works.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=relationtree-photos-dev
# Local LLM. Defaults shown; only set what you change.
# OLLAMA_URL=http://127.0.0.1:11434   # not localhost: ~2 s IPv6 fallback per call on Windows
# CHAT_MODEL=qwen3.8:27b
# EMBED_MODEL=qwen3-embedding:0.6b
# OLLAMA_KEEP_ALIVE=1h

# Local-only dev login created during M8 (`createsuperuser --username dev`); exists only in
# your local Postgres volume. Username: dev  Password: devpass-relationtree
