# Copy to .env.prod (git-ignored) on the home server. Read by compose.yml via start.ps1.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# Compose: database password (hex keeps it URL-safe) and the Cloudflare Tunnel token
# (Zero Trust -> Networks -> Tunnels -> relationtree -> Overview: the eyJ... string).
POSTGRES_PASSWORD=
TUNNEL_TOKEN=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# The tunnel hostname, plus 127.0.0.1 for the admin on this machine.
DJANGO_ALLOWED_HOSTS=relationtree-api.johnchau.org,127.0.0.1,localhost
FRONTEND_ORIGINS=https://relationtree.johnchau.org

# Photos: the prod bucket, whose CORS allows https://relationtree.johnchau.org
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=relationtree-photos-prod

# Backups: separate bucket and token (bucket lock on daily/, lifecycle expiry on daily/)
CLOUDFLARE_R2_BACKUP_ACCESS_KEY_ID=
CLOUDFLARE_R2_BACKUP_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BACKUP_BUCKET_NAME=relationtree-backups
# healthchecks.io ping URL. Empty: backups run but nobody is alerted when they stop.
HEALTHCHECK_URL=
