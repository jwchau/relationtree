{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relationtree-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "relationtree-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "config.asgi:application",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "relationtree-embed-worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "python",
        "manage.py",
        "embed_worker"
      ]
    }
  ]
}
